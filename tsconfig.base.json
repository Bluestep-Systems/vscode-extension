{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // TypeScript 7 does not pull every `node_modules/@types` package into the
    // global scope the way 5.x did, so the ambient declarations we depend on —
    // node's builtins, the `vscode` module, and mocha's BDD globals in `src/test/` —
    // have to be requested by name.
    "types": ["node", "vscode", "mocha"],
    "noImplicitOverride": true
  }
}
