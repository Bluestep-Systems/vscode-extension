.vscode/**
.vscode-test/**
out/**
node_modules/**
src/**
.gitignore
.yarnrc
esbuild.js
package-extension.js
vsc-extension-quickstart.md
**/tsconfig.json
**/*.map
**/*.ts
# ...but dist/lib/lib.*.d.ts must ship: the bundled b6p-core resolves TypeScript's
# standard library from there on a snapshot push (see esbuild.js copy-ts-libs).
# package-extension.js archives dist/ wholesale and does not read this file, so this
# negation only matters if the .vsix is ever built with vsce — which is exactly when
# the omission would be silent.
!dist/lib/**
**/.vscode-test.*
*.vsix
*.zip
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
../**
